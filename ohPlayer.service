[Unit]
Description=Startup Open Home Player
After=network-online.target
Wants=network-online.target

[Service]
#Environment="OHP_DEBUG=1"
ExecStart=/home/jean/ohPlayer/linux/raspbian/openhome-player -s /home/jean/.config/OpenHomePlayer/ohPersist --webui 8080
StandardOutput=append:/var/log/ohp.log
StandardError=append:/var/log/ohp.log
User=jean
Type=simple
Restart=always
KillSignal=SIGINT
[Install]
WantedBy=multi-user.target
